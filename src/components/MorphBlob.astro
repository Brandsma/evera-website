---
interface Props {
  fill: string;
  opacity?: number;
  dur?: number;
  seed?: number;
  style?: string;
}

const { fill, opacity = 0.7, dur = 18000, seed = 0, style } = Astro.props;
---

<svg
  viewBox="0 0 400 400"
  style={style}
  preserveAspectRatio="xMidYMid meet"
  data-morph-blob
  data-dur={dur}
  data-seed={seed}
>
  <path d="" fill={fill} opacity={opacity}></path>
</svg>

<script>
  function blobPath(t: number, seed: number): string {
    const cx = 200, cy = 200, n = 8;
    const pts: [number, number][] = [];
    for (let i = 0; i < n; i++) {
      const ang = (i / n) * Math.PI * 2;
      const r = 150
        + Math.sin(t * Math.PI * 2 + i * 0.9 + seed * 6) * 20
        + Math.cos(t * Math.PI * 2 * 1.3 + i * 1.7) * 12;
      pts.push([cx + Math.cos(ang) * r, cy + Math.sin(ang) * r]);
    }
    let path = `M ${pts[0][0].toFixed(1)} ${pts[0][1].toFixed(1)}`;
    for (let i = 0; i < n; i++) {
      const p0 = pts[(i - 1 + n) % n];
      const p1 = pts[i];
      const p2 = pts[(i + 1) % n];
      const p3 = pts[(i + 2) % n];
      const c1x = p1[0] + (p2[0] - p0[0]) / 6;
      const c1y = p1[1] + (p2[1] - p0[1]) / 6;
      const c2x = p2[0] - (p3[0] - p1[0]) / 6;
      const c2y = p2[1] - (p3[1] - p1[1]) / 6;
      path += ` C ${c1x.toFixed(1)} ${c1y.toFixed(1)}, ${c2x.toFixed(1)} ${c2y.toFixed(1)}, ${p2[0].toFixed(1)} ${p2[1].toFixed(1)}`;
    }
    return path + ' Z';
  }

  const blobs: { path: SVGPathElement; dur: number; seed: number }[] = [];
  for (const svg of document.querySelectorAll<SVGSVGElement>('svg[data-morph-blob]')) {
    const path = svg.querySelector('path');
    if (!path) continue;
    blobs.push({
      path,
      dur: Number(svg.dataset.dur) || 18000,
      seed: Number(svg.dataset.seed) || 0,
    });
  }

  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    // Draw each blob once in its starting shape, without animating.
    for (const b of blobs) b.path.setAttribute('d', blobPath(b.seed % 1, b.seed));
  } else if (blobs.length) {
    let start: number | undefined;
    requestAnimationFrame(function tick(ts) {
      start ??= ts;
      for (const b of blobs) {
        const t = ((ts - start) / b.dur + b.seed) % 1;
        b.path.setAttribute('d', blobPath(t, b.seed));
      }
      requestAnimationFrame(tick);
    });
  }
</script>
